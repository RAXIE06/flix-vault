{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build && esbuild api/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.cjs --external:express --external:mongoose --external:cookie-parser --external:dotenv --external:express-rate-limit --external:imapflow --external:mailparser",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/verify-upi-qr.ts && tsx tests/gmail-imap-parser.test.ts && tsx tests/payment-verification.test.ts && tsx tests/poster-storage.test.ts && tsx tests/regressions.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "imapflow": "^2.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.38",
    "mongoose": "^8.0.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
